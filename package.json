{
  "name": "gladys-nasweb",
  "version": "0.1.0",
  "private": true,
  "description": "Gladys Assistant external integration for NASweb modules (relay outputs, inputs, temperature), over the local API of the module. Unofficial, not affiliated with nasWebio.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "receiver": "node src/receiver.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs",
    "validate:manifest": "npx --yes github:GladysAssistant/integration-store ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0"
}
